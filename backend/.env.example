# Example values only. Inject real secrets via the deployment environment.
# Python does not automatically load this file.
PUBLIC_ORIGIN=https://tracker.example.com
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=Knightro Tracker <verified@example.com>
SMTP_USER=replace-with-regional-ses-smtp-user
SMTP_PASSWORD=replace-with-regional-ses-smtp-password
# Browser public key, private signing key/path, and a contact URI.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
