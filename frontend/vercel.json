{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/proxy.mjs": {"maxDuration": 30},
    "api/photo_check.py": {"maxDuration": 30, "excludeFiles": "{assets,css,js,data,tests}/**"}
  },
  "rewrites": [
    {"source": "/internal/photo-check", "destination": "/api/photo_check"},
    {"source": "/api/:path*", "destination": "/api/proxy?route=:path*"}
  ],
  "headers": [{"source": "/api/:path*", "headers": [{"key": "Cache-Control", "value": "no-store"}]}]
}
